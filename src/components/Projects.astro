---
import { fetchAllRepos, timeAgo } from '../lib/github';
import { projects } from '../lib/projects.config';

const repos = await fetchAllRepos(projects);

const LANG_COLOR: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#eab308',
  HTML: '#e34c26',
  CSS: '#264de4',
  Python: '#3572A5',
  'C#': '#68217a',
  C: '#555555',
  'C++': '#f34b7d',
  Lua: '#000080',
};
---

<section id="projects">
  <div class="container">
    <p class="eyebrow">projects</p>
    <h2 class="section-title">git log --pinned</h2>
    <p class="section-sub">
      Live from GitHub — stars, language, and last commit time pull
      straight from the repos, so this list never goes stale.
    </p>

    <div class="repo-list">
      {repos.map((repo, idx) => (
        <a class="repo-card" href={repo.url} target="_blank" rel="noopener" style={`--delay: ${idx * 60}ms`}>
          <div class="repo-head">
            <span class="repo-name">{repo.displayName}</span>
            <span class="repo-arrow">↗</span>
          </div>
          <p class="repo-desc">{repo.description}</p>
          <div class="repo-meta">
            {repo.language && (
              <span class="repo-lang">
                <span class="lang-dot" style={`background: ${LANG_COLOR[repo.language] ?? 'var(--ink-2)'}`}></span>
                {repo.language}
              </span>
            )}
            <span class="repo-stat">★ {repo.stars}</span>
            <span class="repo-stat">⑂ {repo.forks}</span>
            <span
              class="repo-updated"
              title={`last commit ${repo.lastCommitAt ? timeAgo(repo.lastCommitAt) : 'unknown'}`}
              data-ago={repo.lastCommitAt ?? ''}
              data-repo={repo.fullName}
            >
              <svg class="repo-updated-icon" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M8 4v4l2.6 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              committed <span class="repo-ago">{repo.lastCommitAt ? timeAgo(repo.lastCommitAt) : '…'}</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    {repos.length === 0 && (
      <p class="repo-empty">Couldn't load projects right now — check back in a bit.</p>
    )}
  </div>
</section>

<style>
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 600;
    margin: 10px 0 12px;
  }

  .section-sub {
    color: var(--ink-2);
    font-size: 0.88rem;
    max-width: 52ch;
    margin-bottom: 36px;
    line-height: 1.6;
  }

  .repo-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .repo-card {
    display: block;
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 20px 22px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease), background 0.25s var(--ease);
    animation: card-in 0.5s var(--ease) both;
    animation-delay: var(--delay);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .repo-card:hover {
    border-color: var(--amber-dim);
    background: var(--bg-2);
    transform: translateY(-3px);
  }

  .repo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .repo-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink-0);
  }

  .repo-arrow {
    color: var(--ink-2);
    transition: transform 0.25s var(--ease), color 0.25s var(--ease);
  }

  .repo-card:hover .repo-arrow {
    color: var(--amber);
    transform: translate(2px, -2px);
  }

  .repo-desc {
    color: var(--ink-1);
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .repo-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.78rem;
    color: var(--ink-2);
  }

  .repo-lang {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .repo-updated {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .repo-updated-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .repo-empty {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
</style>

<script>
  const GITHUB_API = 'https://api.github.com';

  function liveAgo(iso: string): string {
    const seconds = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
    const units: [number, string][] = [
      [31536000, 'y'],
      [2592000, 'mo'],
      [604800, 'w'],
      [86400, 'd'],
      [3600, 'h'],
      [60, 'min'],
    ];
    for (const [secs, label] of units) {
      const value = Math.floor(seconds / secs);
      if (value >= 1) return `${value}${label} ago`;
    }
    return 'just now';
  }

  function refreshAgo() {
    document.querySelectorAll<HTMLElement>('[data-ago]').forEach((el) => {
      const span = el.querySelector('.repo-ago');
      if (span && el.dataset.ago) span.textContent = liveAgo(el.dataset.ago);
    });
  }

  async function refreshCommitDates() {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-repo]'));
    await Promise.all(
      els.map(async (el) => {
        const repo = el.dataset.repo;
        const span = el.querySelector('.repo-ago');
        if (!repo || !span) return;
        try {
          const res = await fetch(`${GITHUB_API}/repos/${repo}/commits?per_page=1`, {
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!res.ok) return;
          const commits = (await res.json()) as { commit?: { committer?: { date?: string } } }[];
          const date = commits[0]?.commit?.committer?.date;
          if (!date) return;
          el.dataset.ago = date;
          span.textContent = liveAgo(date);
          el.title = `last commit ${liveAgo(date)}`;
        } catch {
        }
      }),
    );
  }

  refreshAgo();
  refreshCommitDates();
  setInterval(refreshAgo, 30000);
</script>